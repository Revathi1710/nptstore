<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    RewriteEngine On

    # 0. One domain only: www -> non-www.
    #    Skip API calls using THE_REQUEST (the ORIGINAL request line), because
    #    REQUEST_URI changes to /index.php after rule 2 rewrites internally.
    RewriteCond %{THE_REQUEST} !^[A-Z]+\s/api/ [NC]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # 1. Pass Authorization & XSRF Headers to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 1b. /sitemap.xml is generated by sitemap.php
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 1c. Let seo.php and sitemap.php run as themselves
    RewriteRule ^(seo|sitemap)\.php$ - [L]

    # 2. API requests or PHP files go to Laravel index.php
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} \.php$
    RewriteRule ^ index.php [L]

    # 3. Serve actual physical files/folders directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Everything else (React Router) goes through seo.php
    RewriteRule ^ seo.php [L]
</IfModule>